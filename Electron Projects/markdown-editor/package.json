{
  "name": "markdown-editor",
  "productName": "markdown-editor",
  "version": "1.0.0",
  "private": true,
  "description": "My Electron application description",
  "keywords": [],
  "license": "MIT",
  "author": "lsoi2025_06",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "vp lint && vp fmt --check",
    "lint:fix": "vp lint --fix && vp fmt --write",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^45.0.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "electron": "^45.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "markdown-it": "^15.0.3",
    "vue": "^3.5.44"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": [
      {
        "name": "pnpm",
        "version": "12.15.0",
        "onFail": "download"
      },
      {
        "name": "npm",
        "version": "12.2.1",
        "onFail": "download"
      }
    ]
  }
}
